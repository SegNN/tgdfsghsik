    <module>modules/EnchantControlReforged</module>
    <module>modules/EventContainer</module>
    <module>modules/EventDeathMine</module>
    <module>modules/EventGruz</module>
    <module>modules/EventManager</module>
    <module>modules/EventPolana</module>
    <module>modules/EventPosilka</module>
    <module>modules/EventShip</module>
    <module>modules/EventZamok</module>
    <module>modules/Expirytime</module>
    <module>modules/HolyAutoCraft</module>
    <module>modules/HolyAutoMine</module>
    <module>modules/HolyBackPack</module>
    <module>modules/HolyBambuk</module>
    <module>modules/HolyCases</module>
    <module>modules/HolyCommandWhitelist</module>
    <module>modules/HolyCore</module>
    <module>modules/HolyCustomEgg</module>
    <module>modules/HolyCustomPlaceholder</module>
    <module>modules/HolyCustomPriv</module>
    <module>modules/HolyEnchantments</module>
    <module>modules/HolyEnderChest</module>
    <module>modules/HolyEventSun</module>
    <module>modules/HolyExpBottle</module>
    <module>modules/HolyExpKeeper</module>
    <module>modules/HolyFreeze</module>
    <module>modules/HolyGoldSpawner</module>
    <module>modules/HolyKits</module>
    <module>modules/HolyLiteEnd</module>
    <module>modules/HolyLiteItems</module>
    <module>modules/HolyLiteShop</module>
    <module>modules/HolyMineSkills</module>
    <module>modules/HolyMobMoney</module>
    <module>modules/HolyPSAddon</module>
    <module>modules/HolyPotion</module>
    <module>modules/HolyPotions</module>
    <module>modules/HolyPromoCode</module>
    <module>modules/HolyPvP</module>
    <module>modules/HolyRTP</module>
    <module>modules/HolySalary</module>
    <module>modules/HolyServerNotify</module>
    <module>modules/HolySfers</module>
    <module>modules/HolySpawneroved</module>
    <module>modules/HolySpawners</module>
    <module>modules/KotikDang</module>
    <module>modules/KotikTotemRune</module>
    <module>modules/LiteAuction</module>
    <module>modules/LiteBinds</module>
    <module>modules/LiteChat</module>
    <module>modules/LiteContainer</module>
    <module>modules/LiteExchange</module>
    <module>modules/LiteStaffChat</module>
    <module>modules/LootManager</module>
    <module>modules/OnesSpec</module>
    <module>modules/PlayTimeAPI</module>
    <module>modules/SaveItems</module>
    <module>modules/Shame</module>
    <module>modules/StickHWCustom</module>
    <module>modules/StickHWStar</module>
    <module>modules/StickHWTnT</module>
  </modules>

  <repositories>
    <repository><id>papermc</id><url>https://repo.papermc.io/repository/maven-public/</url></repository>
    <repository><id>spigotmc</id><url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url></repository>
    <repository><id>sonatype</id><url>https://oss.sonatype.org/content/groups/public/</url></repository>
    <repository><id>jitpack</id><url>https://jitpack.io</url></repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.21.4-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs><arg>-nowarn</arg></compilerArgs>
          <showWarnings>false</showWarnings>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.3</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter><artifact>*:*</artifact>
                  <excludes><exclude>META-INF/*.SF</exclude><exclude>META-INF/*.DSA</exclude><exclude>META-INF/*.RSA</exclude><exclude>module-info.class</exclude></excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
